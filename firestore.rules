rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model & Multi-Tenant Architecture
    // ===============================================================
    //
    // - /careers/{careerId}: Curricular catalog (read-only public, write for admin)
    // - /career_paths/{careerId}: Deterministic 16-station paths (read-only public, write for admin)
    // - /placement_tests/{testId}: Diagnostic placement results (owner / same-institution teacher / admin read, authenticated create, admin update/delete)
    // - /diagnostic_passports/{passportId}: Accredited CEFR diagnostic passports (owner / same-institution teacher / admin read, owner create with schema validation, admin update/delete)
    // - /users/{userId}: User profiles with RBAC role/admin field lockdown (owner / same-institution teacher / admin read)
    // - /institutions/{institutionId}: Multi-tenant institution metadata (institution members & admin read) & subcollections:
    //   - /placement_tests/{testId}: Institutional diagnostic records
    //   - /classes/{classId} & /submissions/{submissionId}: Cohort management (teacher ownership enforced on create, bounded +1 studentsCount increment) & Hito submissions (no pre-graded fields)
    //     - /curriculum_config/{trackKey}: Cohort 50m sequence ordering, visibility & unlocks (institution read, class owner/admin write)
    //     - /assignments/{assignmentId}: Cohort assignments & due metadata (institution read, class owner/admin write)
    //   - /teachers/{teacherId}: Faculty roster scoped to institution
    //   - /students/{studentId}, /station_progress/{stationId}, /mcer_progress/{unitId}: Institution-scoped student portfolios & validated progress
    //   - /audit_logs/{logId}: Immutable ISO 9001:2015 audit trail (institution-scoped, actor-bound, size-bounded)
    // ===============================================================

    // Helper functions for authentication & role verification
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return request.auth.token.get('role', '');
    }

    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'admin' || request.auth.token.get('admin', false) == true);
    }

    function isTeacher() {
      return isAuthenticated() && (getUserRole() == 'teacher' || isAdmin());
    }

    function isStudent() {
      return isAuthenticated() && (!('role' in request.auth.token) || getUserRole() == 'student');
    }

    function belongsToInstitution(institutionId) {
      return isAuthenticated() &&
             institutionId is string &&
             institutionId.size() > 0 &&
             (request.auth.token.get('institutionId', '') == institutionId || isAdmin());
    }

    // Check if the authenticated teacher owns the parent class document
    function isClassOwner(institutionId, classId) {
      let classPath = /databases/$(database)/documents/institutions/$(institutionId)/classes/$(classId);
      return isTeacher() &&
             belongsToInstitution(institutionId) &&
             exists(classPath) &&
             get(classPath).data.get('teacherId', '') == request.auth.uid;
    }

    function isValidOptionalStringBound(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isValidOptionalTimestampOrIso(data, field) {
      return !(field in data) ||
             data[field] is timestamp ||
             (data[field] is string && data[field].size() <= 64);
    }

    function isValidIdList(val, maxItems) {
      return val is list &&
             val.size() <= maxItems &&
             (val.size() == 0 || (val[0] is string && val[0].size() <= 100 &&
                                  val[val.size() - 1] is string && val[val.size() - 1].size() <= 100));
    }

    // Domain Validator: Cohort curriculum sequence configuration
    function isValidCurriculumConfig(data, institutionId, classId) {
      return data.keys().hasOnly([
               'classId', 'institutionId', 'trackKey',
               'orderedIds', 'hiddenIds', 'unlockedIds',
               'paceMinutes', 'note', 'updatedAt', 'updatedBy', 'syncedAt'
             ]) &&
             (!('classId' in data) || (data.classId is string && data.classId == classId && data.classId.size() > 0 && data.classId.size() <= 128)) &&
             (!('institutionId' in data) || (data.institutionId is string && data.institutionId == institutionId && data.institutionId.size() > 0 && data.institutionId.size() <= 128)) &&
             (!('trackKey' in data) || (data.trackKey is string && data.trackKey.size() > 0 && data.trackKey.size() <= 80)) &&
             (!('orderedIds' in data) || isValidIdList(data.orderedIds, 150)) &&
             (!('hiddenIds' in data) || isValidIdList(data.hiddenIds, 150)) &&
             (!('unlockedIds' in data) || isValidIdList(data.unlockedIds, 150)) &&
             (!('paceMinutes' in data) || (data.paceMinutes is number && data.paceMinutes >= 15 && data.paceMinutes <= 180)) &&
             isValidOptionalStringBound(data, 'note', 1000) &&
             isValidOptionalStringBound(data, 'updatedBy', 128) &&
             isValidOptionalTimestampOrIso(data, 'updatedAt') &&
             isValidOptionalTimestampOrIso(data, 'syncedAt');
    }

    // Domain Validator: Cohort assignment
    // Includes both canonical schema fields (targetType, targetId, dueDate, notes, points, createdBy, status)
    // and active teacher.html payload fields (level, scope, threshold, deadline, dueTime, timeLimitMinutes, timezone, instructions, assignedAt, submissions)
    function isValidClassAssignment(data, institutionId, classId) {
      return data.keys().hasOnly([
               'id', 'classId', 'institutionId', 'title', 'targetType', 'targetId',
               'dueDate', 'notes', 'points', 'createdBy', 'createdAt', 'updatedAt',
               'syncedAt', 'status',
               'level', 'scope', 'threshold', 'deadline', 'dueTime',
               'timeLimitMinutes', 'timezone', 'instructions', 'assignedAt', 'submissions'
             ]) &&
             (!('id' in data) || (data.id is string && data.id.size() > 0 && data.id.size() <= 128)) &&
             (!('classId' in data) || (data.classId is string && data.classId == classId && data.classId.size() > 0 && data.classId.size() <= 128)) &&
             (!('institutionId' in data) || (data.institutionId is string && data.institutionId == institutionId && data.institutionId.size() > 0 && data.institutionId.size() <= 128)) &&
             isValidOptionalStringBound(data, 'title', 200) &&
             isValidOptionalStringBound(data, 'targetType', 60) &&
             isValidOptionalStringBound(data, 'targetId', 128) &&
             isValidOptionalTimestampOrIso(data, 'dueDate') &&
             isValidOptionalStringBound(data, 'notes', 2000) &&
             (!('points' in data) || (data.points is number && data.points >= 0 && data.points <= 10000)) &&
             isValidOptionalStringBound(data, 'createdBy', 128) &&
             isValidOptionalTimestampOrIso(data, 'createdAt') &&
             isValidOptionalTimestampOrIso(data, 'updatedAt') &&
             isValidOptionalTimestampOrIso(data, 'syncedAt') &&
             isValidOptionalStringBound(data, 'status', 40) &&
             isValidOptionalStringBound(data, 'level', 20) &&
             isValidOptionalStringBound(data, 'scope', 64) &&
             (!('threshold' in data) || (data.threshold is number && data.threshold >= 0 && data.threshold <= 100)) &&
             isValidOptionalStringBound(data, 'deadline', 64) &&
             isValidOptionalStringBound(data, 'dueTime', 32) &&
             (!('timeLimitMinutes' in data) || (data.timeLimitMinutes is number && data.timeLimitMinutes >= 0 && data.timeLimitMinutes <= 600)) &&
             isValidOptionalStringBound(data, 'timezone', 64) &&
             isValidOptionalStringBound(data, 'instructions', 2000) &&
             isValidOptionalTimestampOrIso(data, 'assignedAt') &&
             (!('submissions' in data) || (data.submissions is map && data.submissions.size() <= 200));
    }

    // Domain Validator: Accredited CEFR diagnostic passport
    function isValidDiagnosticPassport(data) {
      return data.keys().hasOnly([
               'uid', 'institutionId', 'folio', 'level', 'cefrLevel',
               'score', 'percentage', 'sectionScores', 'student',
               'issuedAt', 'verifiedAt', 'createdAt', 'waived',
               'fastTrackEligible', 'recommendedTrackId'
             ]) &&
             'uid' in data &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             isValidOptionalStringBound(data, 'institutionId', 128) &&
             isValidOptionalStringBound(data, 'folio', 128) &&
             (!('level' in data) || (data.level is string && data.level in ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'])) &&
             (!('cefrLevel' in data) || (data.cefrLevel is string && data.cefrLevel in ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'])) &&
             (!('score' in data) || (data.score is number && data.score >= 0 && data.score <= 1000)) &&
             (!('percentage' in data) || (data.percentage is number && data.percentage >= 0 && data.percentage <= 100)) &&
             (!('sectionScores' in data) || (data.sectionScores is map && data.sectionScores.size() <= 20)) &&
             (!('student' in data) || (data.student is map && data.student.size() <= 30)) &&
             isValidOptionalTimestampOrIso(data, 'issuedAt') &&
             isValidOptionalTimestampOrIso(data, 'verifiedAt') &&
             isValidOptionalTimestampOrIso(data, 'createdAt') &&
             (!('waived' in data) || data.waived is bool) &&
             (!('fastTrackEligible' in data) || data.fastTrackEligible is bool) &&
             isValidOptionalStringBound(data, 'recommendedTrackId', 100);
    }

    // Domain Validator: Student submission create (forbids pre-populating graded fields)
    function isValidSubmissionCreate(data, institutionId) {
      return data.keys().size() <= 30 &&
             !data.keys().hasAny(['score', 'grade', 'gradedAt', 'gradedBy', 'teacherFeedback', 'xpAwarded']) &&
             data.get('studentId', '') == request.auth.uid &&
             data.get('institutionId', '') == institutionId &&
             (!('status' in data) || (data.status is string && data.status in ['submitted', 'pending'])) &&
             isValidOptionalStringBound(data, 'assignmentId', 128) &&
             isValidOptionalStringBound(data, 'classId', 128) &&
             isValidOptionalStringBound(data, 'studentName', 150) &&
             isValidOptionalStringBound(data, 'content', 10000) &&
             isValidOptionalStringBound(data, 'notes', 2000) &&
             (!('answers' in data) || ((data.answers is map && data.answers.size() <= 100) || (data.answers is list && data.answers.size() <= 100))) &&
             isValidOptionalTimestampOrIso(data, 'submittedAt') &&
             isValidOptionalTimestampOrIso(data, 'createdAt') &&
             isValidOptionalTimestampOrIso(data, 'updatedAt');
    }

    // Domain Validator: Teacher/admin grading update on submission
    function isValidSubmissionUpdate(data, existing, institutionId) {
      return data.keys().size() <= 35 &&
             data.get('studentId', '') == existing.get('studentId', '') &&
             data.get('institutionId', '') == institutionId &&
             (!('score' in data) || (data.score is number && data.score >= 0 && data.score <= 1000)) &&
             (!('xpAwarded' in data) || (data.xpAwarded is number && data.xpAwarded >= 0 && data.xpAwarded <= 10000)) &&
             isValidOptionalStringBound(data, 'status', 40) &&
             isValidOptionalStringBound(data, 'teacherFeedback', 4000) &&
             isValidOptionalStringBound(data, 'gradedBy', 128) &&
             isValidOptionalTimestampOrIso(data, 'gradedAt') &&
             isValidOptionalTimestampOrIso(data, 'updatedAt');
    }

    // Domain Validator: Student station progress document
    function isValidStationProgress(data) {
      return data.keys().hasOnly([
               'stationId', 'careerId', 'trackId', 'title', 'status',
               'score', 'progress', 'xpEarned', 'hoursCompleted', 'attempts',
               'passed', 'completed', 'completedAt', 'startedAt', 'updatedAt',
               'syncedAt', 'notes'
             ]) &&
             isValidOptionalStringBound(data, 'stationId', 128) &&
             isValidOptionalStringBound(data, 'careerId', 128) &&
             isValidOptionalStringBound(data, 'trackId', 128) &&
             isValidOptionalStringBound(data, 'title', 200) &&
             isValidOptionalStringBound(data, 'status', 40) &&
             (!('score' in data) || (data.score is number && data.score >= 0 && data.score <= 1000)) &&
             (!('progress' in data) || (data.progress is number && data.progress >= 0 && data.progress <= 100)) &&
             (!('xpEarned' in data) || (data.xpEarned is number && data.xpEarned >= 0 && data.xpEarned <= 10000)) &&
             (!('hoursCompleted' in data) || (data.hoursCompleted is number && data.hoursCompleted >= 0 && data.hoursCompleted <= 500)) &&
             (!('attempts' in data) || (data.attempts is int && data.attempts >= 0 && data.attempts <= 1000)) &&
             (!('passed' in data) || data.passed is bool) &&
             (!('completed' in data) || data.completed is bool) &&
             isValidOptionalTimestampOrIso(data, 'completedAt') &&
             isValidOptionalTimestampOrIso(data, 'startedAt') &&
             isValidOptionalTimestampOrIso(data, 'updatedAt') &&
             isValidOptionalTimestampOrIso(data, 'syncedAt') &&
             isValidOptionalStringBound(data, 'notes', 1000);
    }

    // Domain Validator: Student MCER unit progress document
    function isValidMcerProgress(data) {
      return data.keys().hasOnly([
               'unitId', 'unitTitle', 'cefr', 'level', 'score', 'passed',
               'xpEarned', 'progress', 'attempts', 'completedAt', 'updatedAt', 'syncedAt'
             ]) &&
             isValidOptionalStringBound(data, 'unitId', 128) &&
             isValidOptionalStringBound(data, 'unitTitle', 200) &&
             (!('cefr' in data) || (data.cefr is string && data.cefr in ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'])) &&
             isValidOptionalStringBound(data, 'level', 20) &&
             (!('score' in data) || (data.score is number && data.score >= 0 && data.score <= 1000)) &&
             (!('passed' in data) || data.passed is bool) &&
             (!('xpEarned' in data) || (data.xpEarned is number && data.xpEarned >= 0 && data.xpEarned <= 10000)) &&
             (!('progress' in data) || (data.progress is number && data.progress >= 0 && data.progress <= 100)) &&
             (!('attempts' in data) || (data.attempts is int && data.attempts >= 0 && data.attempts <= 1000)) &&
             isValidOptionalTimestampOrIso(data, 'completedAt') &&
             isValidOptionalTimestampOrIso(data, 'updatedAt') &&
             isValidOptionalTimestampOrIso(data, 'syncedAt');
    }

    // Domain Validator: Immutable ISO 9001:2015 audit log entry
    function isValidAuditLog(data, institutionId) {
      return data.keys().hasOnly([
               'id', 'institutionId', 'action', 'entity', 'entityId',
               'details', 'timestamp', 'actor', 'actorUid', 'metadata'
             ]) &&
             data.get('institutionId', institutionId) == institutionId &&
             (data.get('actorUid', '') == request.auth.uid || data.get('actor', '') == request.auth.uid) &&
             isValidOptionalStringBound(data, 'id', 128) &&
             'action' in data && data.action is string && data.action.size() > 0 && data.action.size() <= 80 &&
             isValidOptionalStringBound(data, 'entity', 64) &&
             (!('entityId' in data) || data.entityId == null || (data.entityId is string && data.entityId.size() <= 128)) &&
             isValidOptionalStringBound(data, 'details', 1000) &&
             isValidOptionalTimestampOrIso(data, 'timestamp') &&
             isValidOptionalStringBound(data, 'actor', 128) &&
             isValidOptionalStringBound(data, 'actorUid', 128) &&
             (!('metadata' in data) || (data.metadata is map && data.metadata.size() <= 20));
    }

    // Public / Curricular Catalogs (Read-only for all, write for admin)
    match /careers/{careerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /career_paths/{careerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Diagnostic Placement Tests & Results (Global)
    match /placement_tests/{testId} {
      allow create: if isAuthenticated() &&
                       (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);
      allow read: if isAdmin() ||
                     (isAuthenticated() && resource.data.get('uid', '') == request.auth.uid) ||
                     (isTeacher() && 'institutionId' in resource.data && belongsToInstitution(resource.data.institutionId));
      allow update, delete: if isAdmin();
    }

    match /diagnostic_passports/{passportId} {
      allow read: if isAdmin() ||
                     (isAuthenticated() && resource.data.get('uid', '') == request.auth.uid) ||
                     (isTeacher() && 'institutionId' in resource.data && belongsToInstitution(resource.data.institutionId));
      allow create: if isAuthenticated() &&
                       request.resource.data.get('uid', '') == request.auth.uid &&
                       (!('institutionId' in request.resource.data) || belongsToInstitution(request.resource.data.institutionId)) &&
                       isValidDiagnosticPassport(request.resource.data);
      allow update: if isAdmin() && isValidDiagnosticPassport(request.resource.data);
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isUser(userId) ||
                     (isTeacher() && 'institutionId' in resource.data && belongsToInstitution(resource.data.institutionId)) ||
                     isAdmin();
      allow create: if isUser(userId) &&
                       (!('role' in request.resource.data) || request.resource.data.role == 'student') &&
                       (!('admin' in request.resource.data) || request.resource.data.admin == false);
      allow update: if (isUser(userId) &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'admin', 'institutionId'])) ||
                       isAdmin();
      allow delete: if isAdmin();
    }

    // Multi-tenant Institution Scope
    match /institutions/{institutionId} {
      allow read: if isAdmin() || belongsToInstitution(institutionId);
      allow write: if isAdmin() && belongsToInstitution(institutionId);

      // Institutional Placement Tests & Baseline Diagnostics
      match /placement_tests/{testId} {
        allow create: if isAuthenticated() &&
                         (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);
        allow read: if (isAuthenticated() && resource.data.get('uid', '') == request.auth.uid) ||
                       (isTeacher() && belongsToInstitution(institutionId)) ||
                       (isAdmin() && belongsToInstitution(institutionId));
        allow update, delete: if isAdmin() && belongsToInstitution(institutionId);
      }

      // Classes & Cohorts
      match /classes/{classId} {
        allow read: if belongsToInstitution(institutionId);
        allow create: if belongsToInstitution(institutionId) &&
                         (isAdmin() || (isTeacher() && request.resource.data.get('teacherId', '') == request.auth.uid)) &&
                         request.resource.data.get('institutionId', institutionId) == institutionId &&
                         request.resource.data.keys().size() <= 40;
        allow update: if (belongsToInstitution(institutionId) &&
                          (isAdmin() ||
                           (isTeacher() &&
                            resource.data.get('teacherId', '') == request.auth.uid &&
                            request.resource.data.get('teacherId', '') == resource.data.get('teacherId', '') &&
                            request.resource.data.get('institutionId', institutionId) == institutionId))) ||
                         (belongsToInstitution(institutionId) &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentsCount', 'updatedAt']) &&
                          request.resource.data.studentsCount is int &&
                          resource.data.get('studentsCount', 0) is int &&
                          request.resource.data.studentsCount == resource.data.get('studentsCount', 0) + 1 &&
                          isValidOptionalTimestampOrIso(request.resource.data, 'updatedAt'));
        allow delete: if isAdmin() && belongsToInstitution(institutionId);

        // Submissions & Hito Milestones
        match /submissions/{submissionId} {
          allow read: if (isUser(resource.data.get('studentId', '')) && belongsToInstitution(institutionId)) ||
                         (isTeacher() && belongsToInstitution(institutionId)) ||
                         (isAdmin() && belongsToInstitution(institutionId));
          allow create: if belongsToInstitution(institutionId) &&
                           isValidSubmissionCreate(request.resource.data, institutionId);
          allow update: if ((isTeacher() || isAdmin()) && belongsToInstitution(institutionId)) &&
                           isValidSubmissionUpdate(request.resource.data, resource.data, institutionId);
          allow delete: if isAdmin() && belongsToInstitution(institutionId);
        }

        // Cohort Curriculum Sequence Configuration (50m pacing, order, visibility & unlocks)
        match /curriculum_config/{trackKey} {
          allow read: if belongsToInstitution(institutionId);
          allow create: if (isClassOwner(institutionId, classId) || (isAdmin() && belongsToInstitution(institutionId))) &&
                           isValidCurriculumConfig(request.resource.data, institutionId, classId);
          allow update: if (isClassOwner(institutionId, classId) || (isAdmin() && belongsToInstitution(institutionId))) &&
                           isValidCurriculumConfig(request.resource.data, institutionId, classId) &&
                           (!('trackKey' in resource.data) || request.resource.data.get('trackKey', resource.data.trackKey) == resource.data.trackKey);
          allow delete: if isClassOwner(institutionId, classId) || (isAdmin() && belongsToInstitution(institutionId));
        }

        // Cohort Assignments
        match /assignments/{assignmentId} {
          allow read: if belongsToInstitution(institutionId);
          allow create: if (isClassOwner(institutionId, classId) || (isAdmin() && belongsToInstitution(institutionId))) &&
                           isValidClassAssignment(request.resource.data, institutionId, classId);
          allow update: if (isClassOwner(institutionId, classId) || (isAdmin() && belongsToInstitution(institutionId))) &&
                           isValidClassAssignment(request.resource.data, institutionId, classId) &&
                           (!('id' in resource.data) || request.resource.data.get('id', resource.data.id) == resource.data.id) &&
                           (!('createdBy' in resource.data) || request.resource.data.get('createdBy', resource.data.createdBy) == resource.data.createdBy);
          allow delete: if isClassOwner(institutionId, classId) || (isAdmin() && belongsToInstitution(institutionId));
        }
      }

      // Teachers Roster
      match /teachers/{teacherId} {
        allow read: if belongsToInstitution(institutionId);
        allow create, update: if ((isUser(teacherId) && isTeacher()) || isAdmin()) &&
                                 belongsToInstitution(institutionId);
        allow delete: if isAdmin() && belongsToInstitution(institutionId);
      }

      // Students & Learning Portfolios
      match /students/{studentId} {
        allow read: if belongsToInstitution(institutionId) &&
                       (isUser(studentId) ||
                        (isStudent() && resource.data.get('uid', '') == request.auth.uid) ||
                        isTeacher() ||
                        isAdmin());
        allow create: if belongsToInstitution(institutionId) &&
                         (!('institutionId' in request.resource.data) || request.resource.data.institutionId == institutionId) &&
                         (
                           ((isUser(studentId) || (isStudent() && request.resource.data.get('uid', '') == request.auth.uid)) &&
                            (!('role' in request.resource.data) || request.resource.data.role == 'student') &&
                            (!('admin' in request.resource.data) || request.resource.data.admin == false)) ||
                           (isTeacher() &&
                            (!('role' in request.resource.data) || request.resource.data.role == 'student') &&
                            (!('admin' in request.resource.data) || request.resource.data.admin == false)) ||
                           isAdmin()
                         );
        allow update: if belongsToInstitution(institutionId) &&
                         (
                           ((isUser(studentId) || (isStudent() && resource.data.get('uid', '') == request.auth.uid && request.resource.data.get('uid', '') == request.auth.uid)) &&
                            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'admin', 'institutionId'])) ||
                           (isTeacher() &&
                            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'admin', 'institutionId'])) ||
                           isAdmin()
                         );
        allow delete: if isAdmin() && belongsToInstitution(institutionId);

        // Student station progress subcollection
        match /station_progress/{stationId} {
          allow read: if belongsToInstitution(institutionId) &&
                         (isUser(studentId) || isTeacher() || isAdmin());
          allow create, update: if belongsToInstitution(institutionId) &&
                                   (isUser(studentId) || isTeacher() || isAdmin()) &&
                                   isValidStationProgress(request.resource.data);
          allow delete: if isAdmin() && belongsToInstitution(institutionId);
        }

        // Student MCER unit progress subcollection
        match /mcer_progress/{unitId} {
          allow read: if belongsToInstitution(institutionId) &&
                         (isUser(studentId) || isTeacher() || isAdmin());
          allow create, update: if belongsToInstitution(institutionId) &&
                                   (isUser(studentId) || isTeacher() || isAdmin()) &&
                                   isValidMcerProgress(request.resource.data);
          allow delete: if isAdmin() && belongsToInstitution(institutionId);
        }
      }

      // Audit Logs & ISO 9001 Compliance Records
      match /audit_logs/{logId} {
        allow read: if (isTeacher() || isAdmin()) && belongsToInstitution(institutionId);
        allow create: if belongsToInstitution(institutionId) &&
                         isValidAuditLog(request.resource.data, institutionId);
        allow update, delete: if false; // Immutable audit log
      }
    }

    // Default deny for any unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
