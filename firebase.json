{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "scripts/**",
      "docs/**",
      "scratch/**",
      "dist/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/generator/**",
        "destination": "/generator.html"
      },
      {
        "source": "/admin/**",
        "destination": "/admin.html"
      },
      {
        "source": "/teacher/**",
        "destination": "/teacher.html"
      },
      {
        "source": "/register/**",
        "destination": "/register.html"
      },
      {
        "source": "/app/**",
        "destination": "/app.html"
      },
      {
        "source": "/placement/**",
        "destination": "/placement.html"
      },
      {
        "source": "/tracks/**",
        "destination": "/tracks.html"
      }
    ]
  },
  "auth": {
    "providers": {
      "anonymous": true,
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "stemOS",
        "authorizedRedirectUris": [
          "https://stemos-org.firebaseapp.com/__/auth/handler",
          "https://stemos.org/__/auth/handler",
          "https://stemos.dev/__/auth/handler"
        ],
        "supportEmail": "yepzhi@gmail.com"
      }
    }
  }
}
